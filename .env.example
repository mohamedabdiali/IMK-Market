# Environment variables for IMK-MARKET
# Copy this file to `.env` for local development / production

# Database (PostgreSQL - required for production)
# Local: postgresql://user:password@localhost:5432/imkmarket
# Cloud: use managed DB URL from provider (AWS RDS, Supabase, Railway, etc.)
DATABASE_URL=postgresql://postgres:password@localhost:5432/imkmarket

# Server
NODE_ENV=development
# API port (this app also supports `PORT` as an alias)
API_PORT=5050
JWT_SECRET=change-me-in-prod
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret
# Comma-separated allowed origins for CORS (required in production)
ALLOWED_ORIGINS=http://localhost:8080

SUPPORT_EMAIL=info@imkmarket.com
SUPPORT_PHONE=+232-76-123-456

# Admin seed user
ADMIN_EMAIL=admin@imkmarket.com
ADMIN_PASSWORD=ChangeMeToSomethingSecure123!

# Payments
PAYMENT_CURRENCY=SLE
CURRENCY_SYMBOL=Le

# Stripe (recommended for secure hosted payments)
STRIPE_SECRET_KEY=sk_test_********************************
STRIPE_WEBHOOK_SECRET=whsec_********************************
PAYMENT_SUCCESS_URL=http://localhost:8080/payment-success
PAYMENT_CANCEL_URL=http://localhost:8080/payment-cancel

# Frontend (Vite)
# Optional override (web uses `/api` via Vite proxy by default)
# VITE_API_BASE_URL=http://localhost:5050/api

# Google OAuth (Seller login)
# Google OAuth Client ID (used by server to verify tokens)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Vite client ID for Google Identity Services
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
