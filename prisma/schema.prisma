// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// MULTI-TENANT & RBAC MODELS
// ============================================

model Tenant {
  id                 String   @id @default(cuid())
  name               String   @unique
  subscriptionType   String   // "E-commerce Business" | "Enterprise" | "Starter"
  subscriptionStatus String   @default("active") // "active" | "suspended" | "cancelled"
  modulesEnabled     Json     @default("[]") // Array of enabled module names
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  users         User[]
  roles         Role[]
  products      Product[]
  orders        Order[]
  notifications Notification[]
  auditLogs     AuditLog[]
  userRoles     UserRole[]
  subscriptions Subscription[]

  @@index([name])
  @@index([subscriptionStatus])
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  username      String?   @unique
  passwordHash  String
  name          String?
  phone         String?
  tenantId      String?
  tenant        Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  isSuperAdmin  Boolean   @default(false)
  mustResetPassword Boolean @default(false)
  passwordUpdatedAt DateTime?
  lastPasswordResetAt DateTime?
  disabled      Boolean   @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  userRoles     UserRole[]
  sellerProfile SellerProfile?
  notifications Notification[]
  auditLogs     AuditLog[]
  refreshTokens RefreshToken[]

  @@index([email])
  @@index([tenantId])
  @@index([isSuperAdmin])
}

model Role {
  id           String   @id @default(cuid())
  name         String
  description  String?
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  isSystemRole Boolean  @default(false) // System roles cannot be deleted
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([name, tenantId])
  @@index([tenantId])
  @@index([isSystemRole])
}

model Permission {
  id          String   @id @default(cuid())
  resource    String   // "dashboard" | "analytics" | "products" | "orders" | "users" | "sellers" | "marketing" | "reports" | "settings" | "notifications" | "audit_logs"
  action      String   // "view" | "create" | "edit" | "delete" | "approve" | "export"
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@index([resource])
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model UserRole {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@index([tenantId])
}

// ============================================
// SELLER MANAGEMENT
// ============================================

model SellerProfile {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName    String
  businessType    String    @default("seller") // "seller" | "supplier" | "manufacturer"
  ownerName       String
  phone           String
  tradeLicense    String?
  emiratesId      String?
  businessAddress String
  bankDetails     Json?     // { accountName, accountNumber, bankName, iban, swiftCode }
  productCategory String
  description     String
  status          String    @default("pending") // "pending" | "active" | "rejected" | "suspended"
  rejectionReason String?
  approvedAt      DateTime?
  approvedBy      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  products Product[]
  statusHistory SellerStatus[]

  @@index([userId])
  @@index([status])
  @@index([businessName])
}

// ============================================
// NOTIFICATION SYSTEM
// ============================================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type      String   // "seller_registration" | "seller_approved" | "seller_rejected" | "new_order" | "order_status" | "low_stock" | "payment_received"
  title     String
  message   String
  data      Json?    // Additional context data
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tenantId])
  @@index([read])
  @@index([createdAt])
}

// ============================================
// AUDIT LOGGING
// ============================================

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId   String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  action     String   // "create" | "update" | "delete" | "approve" | "reject"
  resource   String   // "user" | "role" | "product" | "order" | "seller" | "tenant"
  resourceId String?
  changes    Json?    // Before/after snapshot
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([tenantId])
  @@index([resource])
  @@index([createdAt])
}

// ============================================
// SUBSCRIPTIONS
// ============================================

model Subscription {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planName     String
  status       String   @default("active") // "active" | "suspended" | "cancelled"
  billingCycle String   @default("monthly") // "monthly" | "yearly"
  price        Float?
  currency     String   @default("USD")
  startedAt    DateTime @default(now())
  endsAt       DateTime?
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
  @@unique([tenantId])
}

// ============================================
// REFRESH TOKENS
// ============================================

model RefreshToken {
  id            String   @id @default(cuid())
  tokenHash     String   @unique
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  replacedById  String?
  replacedBy    RefreshToken? @relation("RefreshTokenRotation", fields: [replacedById], references: [id])
  replacements  RefreshToken[] @relation("RefreshTokenRotation")

  @@index([userId])
  @@index([expiresAt])
}

// ============================================
// SELLER STATUS HISTORY
// ============================================

model SellerStatus {
  id         String   @id @default(cuid())
  sellerId   String
  sellerProfile SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  status     String
  note       String?
  changedBy  String?
  changedAt  DateTime @default(now())

  @@index([sellerId])
  @@index([status])
  @@index([changedAt])
}

// ============================================
// SYSTEM SETTINGS & FEATURE TOGGLES
// ============================================

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model FeatureToggle {
  id          String   @id @default(cuid())
  key         String   @unique
  description String?
  enabled     Boolean  @default(false)
  updatedBy   String?
  updatedAt   DateTime @updatedAt
}

// ============================================
// EXISTING MODELS (ENHANCED)
// ============================================

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([name])
}

model Product {
  id                String         @id @default(cuid())
  name              String
  description       String
  price             Float
  originalPrice     Float?
  image             String
  images            String[]       @default([])
  videos            String[]       @default([])
  categoryId        String
  category          Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  rating            Float          @default(4.5)
  reviewCount       Int            @default(0)
  inStock           Boolean        @default(true)
  freeShipping      Boolean        @default(false)
  badge             String?
  sku               String         @unique
  stock             Int            @default(0)
  lowStockThreshold Int            @default(10)
  lastRestocked     DateTime       @default(now())
  sellerName        String?        // Deprecated - use sellerProfile instead
  sellerEmail       String?        // Deprecated - use sellerProfile instead
  sellerId          String?        // Foreign key to SellerProfile
  sellerProfile     SellerProfile? @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  tenantId          String?
  tenant            Tenant?        @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  country           String         @default("UAE")
  status            String         @default("active") // "active" | "inactive"
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  orderItems OrderItem[]

  @@index([categoryId])
  @@index([status])
  @@index([name])
  @@index([sellerId])
  @@index([tenantId])
}

model PendingProduct {
  id          String   @id @default(cuid())
  name        String
  price       Float
  category    String
  sellerName  String
  sellerEmail String
  description String
  image       String
  status      String   @default("pending") // "pending" | "approved" | "rejected"
  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}

model Order {
  id                 String   @id @default(cuid())
  customerName       String
  customerEmail      String
  customerPhone      String
  shippingAddress    String
  status             String   @default("pending") // "pending" | "processing" | "shipped" | "delivered" | "cancelled"
  total              Float
  paymentMethod      String   // "cod" | "orange_money" | "afrimoney" | "qmoney" | "paystack" | "stripe"
  paymentStatus      String   @default("pending") // "pending" | "initialized" | "paid" | "failed"
  paymentReference   String?
  cargoType          String?
  trackingNumber     String?  @unique
  trackingCarrier    String?
  trackingUrl        String?
  currentLocation    String?
  estimatedDelivery  DateTime?
  shippedAt          DateTime?
  deliveredAt        DateTime?
  lastTrackingUpdate DateTime?
  tenantId           String?
  tenant             Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  sellerId           String?  // If order contains seller products
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  items          OrderItem[]
  trackingEvents OrderTrackingEvent[]

  @@index([customerEmail])
  @@index([status])
  @@index([createdAt])
  @@index([tenantId])
  @@index([sellerId])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  quantity    Int
  price       Float
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

model OrderTrackingEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  title     String
  message   String
  location  String?
  source    String   @default("system") // "system" | "admin"
  eventAt   DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([eventAt])
}

model Payment {
  id                String   @id @default(cuid())
  provider          String   // "orange_money" | "afrimoney" | "qmoney" | "paystack" | "stripe"
  status            String   @default("pending") // "pending" | "paid" | "failed" | "cancelled"
  amount            Float
  currency          String   @default("USD") // "SLE" | "SLL" | "USD"
  reference         String   @unique
  providerReference String?
  items             Json?
  paymentMethod     String   // "orange_money" | "afrimoney" | "qmoney" | "paystack" | "stripe"
  paymentReference  String?
  customerName      String
  customerEmail     String
  customerPhone     String
  shippingAddress   String
  cargoType         String?
  orderId           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([reference])
  @@index([status])
  @@index([customerEmail])
}

model EmailHistory {
  id        String   @id @default(cuid())
  to        String
  subject   String
  template  String   // "orderConfirmation" | "orderShipped" | "orderDelivered" | "welcomeSeller"
  sentAt    DateTime @default(now())
  status    String   @default("Sent") // "Sent" | "Resent" | "Failed"
  createdAt DateTime @default(now())

  @@index([to])
  @@index([createdAt])
}
