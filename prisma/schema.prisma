// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  role          String   @default("user") // "admin" | "user"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([email])
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([name])
}

model Product {
  id                  String   @id @default(cuid())
  name                String
  description         String
  price               Float
  originalPrice       Float?
  image               String
  images              String[] @default([])
  categoryId          String
  category            Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  rating              Float    @default(4.5)
  reviewCount         Int      @default(0)
  inStock             Boolean  @default(true)
  freeShipping        Boolean  @default(false)
  badge               String?
  sku                 String   @unique
  stock               Int      @default(0)
  lowStockThreshold   Int      @default(10)
  lastRestocked       DateTime @default(now())
  sellerName          String?
  sellerEmail         String?
  country             String   @default("UAE")
  status              String   @default("active") // "active" | "inactive"
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  orderItems OrderItem[]

  @@index([categoryId])
  @@index([status])
  @@index([name])
}

model PendingProduct {
  id          String   @id @default(cuid())
  name        String
  price       Float
  category    String
  sellerName  String
  sellerEmail String
  description String
  image       String
  status      String   @default("pending") // "pending" | "approved" | "rejected"
  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}

model Order {
  id               String   @id @default(cuid())
  customerName     String
  customerEmail    String
  customerPhone    String
  shippingAddress  String
  status           String   @default("pending") // "pending" | "processing" | "shipped" | "delivered" | "cancelled"
  total            Float
  paymentMethod    String   // "cod" | "orange_money" | "afrimoney" | "qmoney" | "paystack" | "stripe"
  paymentStatus    String   @default("pending") // "pending" | "initialized" | "paid" | "failed"
  paymentReference String?
  cargoType        String?
  trackingNumber   String?  @unique
  trackingCarrier  String?
  trackingUrl      String?
  currentLocation  String?
  estimatedDelivery DateTime?
  shippedAt        DateTime?
  deliveredAt      DateTime?
  lastTrackingUpdate DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  items          OrderItem[]
  trackingEvents OrderTrackingEvent[]

  @@index([customerEmail])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  quantity    Int
  price       Float
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

model OrderTrackingEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  title     String
  message   String
  location  String?
  source    String   @default("system") // "system" | "admin"
  eventAt   DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([eventAt])
}

model Payment {
  id                  String   @id @default(cuid())
  provider            String   // "orange_money" | "afrimoney" | "qmoney" | "paystack" | "stripe"
  status              String   @default("pending") // "pending" | "paid" | "failed" | "cancelled"
  amount              Float
  currency            String   @default("USD") // "SLE" | "SLL" | "USD"
  reference           String   @unique
  providerReference   String?
  items               Json?
  paymentMethod       String   // "orange_money" | "afrimoney" | "qmoney" | "paystack" | "stripe"
  paymentReference    String?
  customerName        String
  customerEmail       String
  customerPhone       String
  shippingAddress     String
  cargoType           String?
  orderId             String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([reference])
  @@index([status])
  @@index([customerEmail])
}

model EmailHistory {
  id        String   @id @default(cuid())
  to        String
  subject   String
  template  String   // "orderConfirmation" | "orderShipped" | "orderDelivered" | "welcomeSeller"
  sentAt    DateTime @default(now())
  status    String   @default("Sent") // "Sent" | "Resent" | "Failed"
  createdAt DateTime @default(now())

  @@index([to])
  @@index([createdAt])
}
